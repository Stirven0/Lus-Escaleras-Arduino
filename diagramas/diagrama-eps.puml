@startuml diagrama-eps
title Diagrama EPS (Entrada - Proceso - Salida) - Escalera Inteligente

skinparam shadowing true
skinparam rectangle {
  RoundCorner 10
  FontName Arial
  FontSize 12
}

rectangle "ENTRADA" as entrada #E0F2FE {
  rectangle "Sensor Ultrasonido Superior\n(Trig/Echo en D10/D11, 5-50cm)" as s1 #BAE6FD
  rectangle "Sensor Ultrasonido Inferior\n(Trig/Echo en D12/D13, 0-20cm)" as s2 #BAE6FD
  rectangle "Alimentación 5V\n(Puerto USB Arduino)" as s3 #BAE6FD
}

rectangle "PROCESO" as proceso #DCFCE7 {
  rectangle "Arduino Uno\n(ATmega328P)" as a1 #86EFAC
  rectangle "medirDistancia()\n(Trig/Echo → cm)" as a2 #86EFAC
  rectangle "Ramp Up por Acercamiento\n(Inferior 0-20cm)" as a3 #86EFAC
  rectangle "Mapeo Distancia → Escalón\n(Superior 5-50cm)" as a4 #86EFAC
  rectangle "Foco de 3 LEDs\n(Seguimiento de persona)" as a5 #86EFAC
  rectangle "Timeout Sin Contacto\n(2000ms)" as a6 #86EFAC
}

rectangle "SALIDA" as salida #FEE2E2 {
  rectangle "LED Escalón 1 (Pin D2 + 220 Ω)" as o1 #FCA5A5
  rectangle "LED Escalón 2 (Pin D3 + 220 Ω)" as o2 #FCA5A5
  rectangle "LED Escalón 3 (Pin D4 + 220 Ω)" as o3 #FCA5A5
  rectangle "LED Escalón 4 (Pin D5 + 220 Ω)" as o4 #FCA5A5
  rectangle "LED Escalón 5 (Pin D6 + 220 Ω)" as o5 #FCA5A5
  rectangle "LED Escalón 6 (Pin D7 + 220 Ω)" as o6 #FCA5A5
  rectangle "LED Escalón 7 (Pin D8 + 220 Ω)" as o7 #FCA5A5
  rectangle "LED Escalón 8 (Pin D9 + 220 Ω)" as o8 #FCA5A5
}

s1 --> a1 : Neutro Trig D10 / Echo D11
s2 --> a1 : Neutro Trig D12 / Echo D13
s3 --> a1 : Voltaje 5V

a1 --> a2
a2 --> a3
a3 --> a4
a4 --> a5
a5 --> a6

a6 --> o1 : Control D2
a6 --> o2 : Control D3
a6 --> o3 : Control D4
a6 --> o4 : Control D5
a6 --> o5 : Control D6
a6 --> o6 : Control D7
a6 --> o7 : Control D8
a6 --> o8 : Control D9

@enduml