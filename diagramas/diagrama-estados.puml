@startuml diagrama-estados
title Máquina de Estados Finitos - Escalera Inteligente

skinparam monochrome false
skinparam shadowing true
skinparam state {
  BackgroundColor<<Reposo>> #E0F2FE
  BorderColor<<Reposo>> #0284C7
  BackgroundColor<<Acercamiento>> #BAE6FD
  BorderColor<<Acercamiento>> #0369A1
  BackgroundColor<<Escalera>> #86EFAC
  BorderColor<<Escalera>> #15803D
  FontName Arial
  FontSize 12
}

[*] --> ESPERANDO

state "ESPERANDO" as ESPERANDO <<Reposo>> : Luces apagadas\nMonitoreo de sensores

state "ACERCAMIENTO" as ACERCAMIENTO <<Acercamiento>> : Ramp up de LEDs\nsegún acercamiento (0-20cm)

state "EN_ESCALERA" as EN_ESCALERA <<Escalera>> : Foco de 3 LEDs\nsiguiendo a la persona (5-50cm)

ESPERANDO --> ACERCAMIENTO : Inferior detecta\n(0-20cm)
ESPERANDO --> EN_ESCALERA : Superior detecta\n(5-50cm)

ACERCAMIENTO --> EN_ESCALERA : Superior detecta\n(5-50cm)
ACERCAMIENTO --> ESPERANDO : Inferior pierde objeto

EN_ESCALERA --> ESPERANDO : Timeout 2000ms\nsin contacto

@enduml