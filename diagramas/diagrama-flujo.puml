@startuml diagrama-flujo
title Diagrama de Flujo del Programa - Escalera Inteligente

skinparam shadowing true
skinparam activity {
  BackgroundColor #F0F9FF
  BorderColor #0284C7
  FontName Arial
  FontSize 12
}

start

:Inicio del programa;

:Inicializar pines de salida:\nLEDs en D2 a D9 (LOW);

:Inicializar sensores ultrasonido:\nSuperior Trig/echo D10/D11\nInferior Trig/echo D12/D13;

repeat
  :Medir distancia sensor superior\n(Función medirDistancia);
  :Medir distancia sensor inferior\n(Función medirDistancia);

  switch (Estado Actual)
  case ( ESPERANDO )
    if (¿Superior detecta 5-50cm?) then (sí)
      :Estado = EN_ESCALERA;\nguardar distancia y tiempo;
    elseif (¿Inferior detecta 0-20cm?) then (sí)
      :Estado = ACERCAMIENTO;
    endif

  case ( ACERCAMIENTO )
    if (¿Superior detecta 5-50cm?) then (sí)
      :Estado = EN_ESCALERA;\nguardar distancia y tiempo;
    elseif (¿Inferior detecta 0-20cm?) then (sí)
      :cantidadLEDs = map(distancia, 20->0, 1->8);
      :Encender primeros N LEDs\n(ramp up desde abajo);
    else (no)
      :Apagar todos;
      :Estado = ESPERANDO;
    endif

  case ( EN_ESCALERA )
    if (¿Superior detecta 5-50cm?) then (sí)
      :escalon = map(distancia, 5->50cm, 7->0);
      :Encender foco de 3 LEDs\n(escalon ± 1);
      :Actualizar tiempo de contacto;
    elseif (¿Pasaron 2000ms sin contacto?) then (sí)
      :Apagar todos los LEDs;
      :Estado = ESPERANDO;
    endif
  endswitch

repeat while (Sistema activo)

@enduml