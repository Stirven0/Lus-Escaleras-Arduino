@startuml diagrama-procesos
title Diagrama de Procesos - Escalera Inteligente

skinparam shadowing true
skinparam swimlane {
  BorderColor #0284C7
  BackgroundColor #F0F9FF
  FontName Arial
  FontSize 12
}

|Sensores IR|
start
:Detección de presencia física\n(Corte de haz infrarrojo);
:Generación de pulso eléctrico\n(Cambio de nivel digital);

|Arduino Uno|
:Lectura continua de pines D10 y D11;
:Filtrado de flanco ascendente (LOW -> HIGH);
:Evaluación del estado actual del sistema;

if (¿Hay evento de sensor o tiempo cumplido?) then (sí)
  :Selección del estado destino en la máquina de estados;
  :Cálculo de secuencia y tiempos (300ms / 5000ms);

  |Salida LEDs|
  if (¿Acción requerida?) then (Encendido)
    :Envío de señal HIGH a pines D2-D9\n(Secuencial de 1 a 8 o 8 a 1);
  else (Apagado)
    :Envío de señal LOW a pines D2-D9\n(Secuencial no bloqueante);
  endif

else (no)
  |Arduino Uno|
  :Mantener lectura continua de sensores;
endif

|Arduino Uno|
:Finalizar iteración y mantener ciclo continuo;

stop
@enduml
