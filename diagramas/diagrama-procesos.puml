@startuml diagrama-procesos
title Diagrama de Procesos - Escalera Inteligente

skinparam shadowing true
skinparam swimlane {
  BorderColor #0284C7
  BackgroundColor #F0F9FF
  FontName Arial
  FontSize 12
}

|Sensores Ultrasonido|
start
:Emisión de pulso de ultrasonido\n(Trig 10µs);
:Recepción del eco\n(Echo -> duración del pulso);

|Arduino Uno|
:Conversión de tiempo a distancia\n(duración * 0.034 / 2);
:Evaluación del estado actual del sistema;
if (¿Hay objeto en alcance?) then (sí)
  if (¿Superior ve objeto?) then (sí)
    :Mapear distancia a escalón\n(5cm -> 8, 50cm -> 1);
    |Salida LEDs|
    :Encender foco de 3 LEDs\n(escalón ± 1);
  else (no)
    :Calcular N LEDs por acercamiento\n(map distancia 20->0, 1->8);
    |Salida LEDs|
    :Encender N LEDs desde abajo\n(ramp up);
  endif
else (no)
  if (¿Timeout 2000ms sin contacto?) then (sí)
    |Salida LEDs|
    :Apagar todos los LEDs;
  else (no)
    |Arduino Uno|
    :Continuar monitoreo;
  endif
endif

|Arduino Uno|
:Finalizar iteración y mantener ciclo continuo;

stop
@enduml